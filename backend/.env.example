# Copy to backend/.env and fill in. Every key is optional:
# without a key, that source is skipped and its data is marked UNKNOWN or falls back to mock data.

# Geoapify (routing and place search). https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# Tavily (web search for incident patterns and road closures). https://app.tavily.com
TAVILY_API_KEY=

# Nebius Token Factory (NVIDIA Nemotron safety/feasibility score). https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Copy the exact model ID from the Token Factory catalog
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Overpass endpoint for OpenStreetMap data (shops, pharmacies, petrol pumps, police, CCTV)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# City used for web searches and mock data
CITY_NAME=Nagpur

# Set to 1 to always use the mock data file (demo without internet)
FORCE_MOCK=0
