# Copy to backend/.env and fill in. Never commit .env or put these keys in the mobile app.
# Every key is optional: without one, that source is skipped and falls back to cache, then mock data, then UNKNOWN.
# Check your keys with: http://localhost:8000/health?check=true

# --- API keys ---

# Geoapify: routes and place search on the trip page. Free key at https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# Tavily: web search for past incidents and road closures. Free key at https://app.tavily.com
TAVILY_API_KEY=

# Nebius Token Factory: NVIDIA Nemotron safety and feasibility estimate. Key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Nemotron model ID: copy it exactly from the Token Factory model catalog (the AI estimate stays off until set)
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# TomTom: live traffic for the routes page (Phase 3). Free key at https://developer.tomtom.com
TOMTOM_API_KEY=

# Mapillary: CCTV cameras detected in street photos, for the camera factor. Free token at https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# --- Settings (defaults are fine) ---

# Nebius API address
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Overpass endpoint for OpenStreetMap data (shops, pharmacies, petrol pumps, police, CCTV). No key needed.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# City used for web searches, place search and mock data
CITY_NAME=Nagpur

# Set to 1 to always use the mock data file (demo without internet)
FORCE_MOCK=0
